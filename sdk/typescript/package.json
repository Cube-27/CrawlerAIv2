{
  "name": "@crawlerai/sdk",
  "version": "0.1.0",
  "description": "A typed TypeScript client for the CrawlerAI API: scrape, map, crawl, batch, extract and search, with job polling, event streaming and webhook verification.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": { "node": ">=20" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "gen": "openapi-typescript ../../frontend/openapi.json -o src/schema.d.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json --outDir .test-out && node --test .test-out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
