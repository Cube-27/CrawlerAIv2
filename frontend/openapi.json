            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Page",
        "tags": [
          "eval"
        ]
      }
    },
    "/v1/eval/pages/{page_id}/labels": {
      "put": {
        "description": "Store one pass of labels (\u00a716.2). `status` `draft` or `labeled` is the labeler's pass and clears any check;\n`checked` is the checker's pass over a labeled page, by someone other than its labeler.",
        "operationId": "put_labels_v1_eval_pages__page_id__labels_put",
        "parameters": [
          {
            "in": "path",
            "name": "page_id",
            "required": true,
            "schema": {
