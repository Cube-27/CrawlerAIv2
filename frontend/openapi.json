            },
            "title": "Rows",
            "type": "array"
          },
          "status": {
            "enum": [
              "draft",
              "labeled",
              "checked"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "label_version",
          "status"
        ],
        "title": "Labels",
        "type": "object"
      },
      "NormalizeRequest": {
        "additionalProperties": false,
