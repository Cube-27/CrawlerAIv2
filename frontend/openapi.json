{
  "components": {
    "schemas": {
      "CaptureRequest": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "platform_store",
              "custom_store",
              "api_backed",
              "job_board",
              "mixed"
            ],
            "title": "Category",
            "type": "string"
          },
          "page_kind": {
            "enum": [
              "detail",
              "listing"
            ],
            "title": "Page Kind",
            "type": "string"
          },
          "schema": {
            "title": "Schema",
            "type": "string"
          },
          "split": {
            "const": "dev",
            "title": "Split",
            "type": "string"
          },
          "urls": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Urls",
            "type": "array"
          }
        },
        "required": [
          "split",
          "schema",
          "page_kind",
          "category",
          "urls"
        ],
        "title": "CaptureRequest",
        "type": "object"
      },
      "CaptureResponse": {
        "additionalProperties": false,
        "properties": {
          "outcomes": {
            "items": {
              "discriminator": {
                "mapping": {
                  "captured": "#/components/schemas/CapturedOut",
                  "skipped": "#/components/schemas/SkippedOut"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/CapturedOut"
                },
                {
                  "$ref": "#/components/schemas/SkippedOut"
                }
              ]
            },
            "title": "Outcomes",
            "type": "array"
          }
        },
        "required": [
          "outcomes"
        ],
        "title": "CaptureResponse",
        "type": "object"
      },
      "CapturedOut": {
        "additionalProperties": false,
        "properties": {
          "block_class": {
            "enum": [
              "ok",
              "blocked",
              "shell",
              "not_found",
              "error"
            ],
            "title": "Block Class",
            "type": "string"
          },
          "capture_id": {
            "format": "uuid",
            "title": "Capture Id",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "kind": {
            "const": "captured",
            "default": "captured",
            "title": "Kind",
            "type": "string"
          },
          "n": {
            "title": "N",
            "type": "integer"
          },
          "page_id": {
            "format": "uuid",
            "title": "Page Id",
            "type": "string"
          },
          "status_code": {
            "title": "Status Code",
            "type": "integer"
          }
        },
        "required": [
          "n",
          "capture_id",
          "page_id",
          "status_code",
          "block_class",
          "error"
        ],
        "title": "CapturedOut",
        "type": "object"
      },
      "FieldErrorOut": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "title": "Field",
