# Every CrawlerAI setting. Copy this file to `.env`: `docker compose up` passes it to the app's containers (without
# it every setting has its default). An empty value counts as unset. In the containers the database, the object store
# and the browser profiles are set by docker-compose.yml, whatever this file says; those values are for a command run
# on the host, such as `crawlerai` or the tests.

# Main database, as the `app` role. Matches infra/docker-compose.yml.
CRAWLERAI_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/crawlerai

# Object store: fs:///<absolute path> or s3://<bucket>[/<prefix>]. Required by a command run on the host; the
# containers keep theirs in a volume.
CRAWLERAI_OBJECT_STORE=

# Redact URLs in logs.
CRAWLERAI_LOG_REDACT_URLS=false

# curl_cffi browser profile for HTTP fetches. Empty: the newest Chrome profile at lock time.
CRAWLERAI_IMPERSONATE=
# Platform adapters that do not run, comma-separated, from: greenhouse, lever, shopify. Empty: every
# adapter runs.
CRAWLERAI_DISABLED_ADAPTERS=

# Fernet key (urlsafe base64 of 32 bytes) the stored cookie state is encrypted with, from the secret store; make one
# with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`. It is used by
# temporary browser profiles (no profile directory, or one held by another process or fetch). Empty: they keep no
# cookie state.
CRAWLERAI_COOKIE_KEY=

# Directory the browser keeps one Chromium profile per site in, across jobs and processes.
# Delete it to reset every profile. Each profile holds its site's cookies (clearance cookies too) in plaintext, as
# Chromium stores them: keep the directory private to the service user. Unset: each profile lasts only while its browser is open.
CRAWLERAI_BROWSER_PROFILES=

# Proxy pools a request's `fetch.proxy_pool` names:
# JSON {"pool_name": "http://user:password@host:port"}.
# Empty: no pools; a request that names one is refused with proxy_pool_unknown.
# A sticky-exit gateway puts {session} in its username or password: "http://user-{session}:password@host:port".
CRAWLERAI_PROXY_POOLS=
# The ISO 3166-1 alpha-2 country this machine's direct fetches go out from (records state it as their egress country),
# and the IANA time zone and BCP 47 locale of its address (the browser's zone and locale). Empty: undeclared. A pool
# declares its own with {"endpoints": [...], "mode": "rotate", "country": "US", "timezone": "America/Chicago",
# "locale": "en-US"}. A country of several zones and no declared timezone sets no zone.
CRAWLERAI_EGRESS_COUNTRY=
CRAWLERAI_EGRESS_TIMEZONE=
CRAWLERAI_EGRESS_LOCALE=

# API access. JSON list of the proxies (addresses or networks) whose Forwarded/X-Forwarded-For
# headers name the client; empty: none, the headers are ignored. Rate limit per API key: 20 req/s, burst 40.
CRAWLERAI_TRUSTED_PROXIES=
CRAWLERAI_API_RATE_PER_S=
CRAWLERAI_API_RATE_BURST=

# LLM providers in failover order: anthropic, gemini or both, comma-separated. Empty: anthropic,gemini.
CRAWLERAI_LLM_PROVIDERS=
# Model ids per provider and model class: `fast` for role C, `strong` for roles A, D and S. Empty: the current
# Haiku- and Flash-Lite-class (fast) and Sonnet- and Flash-class (strong) models (see core/settings.py).
CRAWLERAI_LLM_FAST_MODEL_ANTHROPIC=
CRAWLERAI_LLM_STRONG_MODEL_ANTHROPIC=
CRAWLERAI_LLM_FAST_MODEL_GEMINI=
CRAWLERAI_LLM_STRONG_MODEL_GEMINI=
# Role A: characters of each sample page's reduced HTML. Empty: 120000.
CRAWLERAI_LLM_A_MAX_CHARS=
# API keys, from the secret store. Required for each listed provider when an LLM client is built.
CRAWLERAI_LLM_API_KEY_ANTHROPIC=
CRAWLERAI_LLM_API_KEY_GEMINI=
# The API key the MCP server's stdio process acts with (`python -m crawlerai.mcp_server`); one that
# `crawlerai apikey create` printed. Unused by the API, whose MCP endpoint takes a bearer key per request.
CRAWLERAI_API_KEY=
# Frontend development only (`pnpm dev` in frontend/, against the API on :8000): the API key its dev proxy acts with,
# one that `crawlerai apikey create` printed. `docker compose up` needs none: it makes the web UI's key itself.
CRAWLERAI_UI_API_KEY=
