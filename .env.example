# Every CrawlerAI setting (SPEC-00 §4.4). `make dev` copies this file to `.env` when `.env` is missing and exports
# it to the processes it starts. An empty value counts as unset. Values in `.env` win over variables exported in
# your shell; to override one for a single run, pass it to make: `make dev CRAWLERAI_DATABASE_URL=...`.

# Main database, as the `app` role. Matches infra/docker-compose.yml.
CRAWLERAI_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/crawlerai

# Object store: fs:///<absolute path> or s3://<bucket>[/<prefix>]. Empty here: `make dev` uses
# fs:///<repo>/.data/objects.
CRAWLERAI_OBJECT_STORE=

# Redact URLs in logs.
CRAWLERAI_LOG_REDACT_URLS=false

# curl_cffi browser profile for HTTP fetches (SPEC-02 §4.7). Empty: the newest Chrome profile at lock time.
CRAWLERAI_IMPERSONATE=
# Platform adapters that do not run (SPEC-15 §4.8), comma-separated, from: greenhouse, lever, shopify. Empty: every
# adapter runs.
CRAWLERAI_DISABLED_ADAPTERS=

# Fernet key (urlsafe base64 of 32 bytes) the stored cookie state is encrypted with, from the secret store; make one
# with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`. It is used by
# temporary browser profiles (no profile directory, or one held by another process or fetch). Empty: they keep no
# cookie state.
CRAWLERAI_COOKIE_KEY=

# Directory the browser keeps one Chromium profile per site in, across jobs and processes (acquisition spec, profiles).
# Delete it to reset every profile. Each profile holds its site's cookies (clearance cookies too) in plaintext, as
# Chromium stores them: keep the directory private to the service user. Empty here: `make dev` uses <repo>/.data/browser-profiles; unset outside make,
# each profile lasts only while its browser is open.
CRAWLERAI_BROWSER_PROFILES=

# Proxy pools a request's `fetch.proxy_pool` names (acquisition spec, "Proxy pools"):
# JSON {"pool_name": "http://user:password@host:port"}.
# Empty: no pools; a request that names one is refused with proxy_pool_unknown.
CRAWLERAI_PROXY_POOLS=
# The ISO 3166-1 alpha-2 country this machine's direct fetches go out from (records state it as their egress country).
# Empty: unknown. A pool declares its own with {"endpoints": [...], "mode": "rotate", "country": "GB"}.
CRAWLERAI_EGRESS_COUNTRY=

# API access (SPEC-07 §4.2). JSON list of the proxies (addresses or networks) whose Forwarded/X-Forwarded-For
# headers name the client; empty: none, the headers are ignored. Rate limit per API key: 20 req/s, burst 40.
CRAWLERAI_TRUSTED_PROXIES=
CRAWLERAI_API_RATE_PER_S=
CRAWLERAI_API_RATE_BURST=

# LLM providers in failover order (SPEC-06 §4.2): anthropic, gemini or both, comma-separated. Empty: anthropic,gemini.
CRAWLERAI_LLM_PROVIDERS=
# Model ids per provider and model class: `fast` for role C, `strong` for roles A, D and S. Empty: the current
# Haiku- and Flash-Lite-class (fast) and Sonnet- and Flash-class (strong) models (see core/settings.py).
CRAWLERAI_LLM_FAST_MODEL_ANTHROPIC=
CRAWLERAI_LLM_STRONG_MODEL_ANTHROPIC=
CRAWLERAI_LLM_FAST_MODEL_GEMINI=
CRAWLERAI_LLM_STRONG_MODEL_GEMINI=
# Role A (SPEC-08 §4.6): characters of each sample page's reduced HTML. Empty: 120000.
CRAWLERAI_LLM_A_MAX_CHARS=
# API keys, from the secret store (ARCHITECTURE §18). Required for each listed provider when an LLM client is built.
CRAWLERAI_LLM_API_KEY_ANTHROPIC=
CRAWLERAI_LLM_API_KEY_GEMINI=
# The API key the MCP server's stdio process acts with (`python -m crawlerai.mcp_server`, SPEC-10 §4.7); one that
# `crawlerai apikey create` printed. Unused by the API, whose MCP endpoint takes a bearer key per request.
CRAWLERAI_API_KEY=
# The API key the web UI acts with (ARCHITECTURE §18, SPEC-14 §4.1); one that `crawlerai apikey create` printed.
# `pnpm dev` reads it from this file (Vite's `loadEnv`; a variable exported in the shell wins there) and attaches it
# to the requests it proxies, so the browser never holds it. Unset: the API answers 401 and the UI shows how to set it.
CRAWLERAI_UI_API_KEY=
