# Import contracts. Run with `uv run lint-imports` from backend/.

[importlinter]
root_package = crawlerai
include_external_packages = True

# The nine field-type normalizers. A new type module is added here and to normalize-internals in
# the PR that creates it.
[importlinter:contract:normalize-independence]
name = One module per field type
type = independence
modules =
    crawlerai.normalize.text
    crawlerai.normalize.money
    crawlerai.normalize.enum
    crawlerai.normalize.url
    crawlerai.normalize.identifier
    crawlerai.normalize.date
    crawlerai.normalize.location
    crawlerai.normalize.range
    crawlerai.normalize.count
    crawlerai.normalize.number

# The dispatcher imports the type modules; the type modules import only `vocab` (vocabularies, their matcher),
# `numbers` (CLDR number reading), `units` (CLDR unit patterns), `strings` (the shared text forms) and `base` (results,
# context) from normalize.
# Independence between the type modules is the contract above, so they are `:` siblings here.
[importlinter:contract:normalize-internals]
name = Normalizer internals
type = layers
layers =
    crawlerai.normalize.dispatch
    crawlerai.normalize.text : crawlerai.normalize.money : crawlerai.normalize.enum : crawlerai.normalize.url : crawlerai.normalize.identifier : crawlerai.normalize.date : crawlerai.normalize.location : crawlerai.normalize.range : crawlerai.normalize.count : crawlerai.normalize.number
    crawlerai.normalize.vocab : crawlerai.normalize.numbers : crawlerai.normalize.units
    crawlerai.normalize.strings
    crawlerai.normalize.base

# Indirect imports are allowed: callers use the normalizers, which use these libraries.
[importlinter:contract:normalize-libs]
name = Only normalizers import normalization libraries
type = forbidden
source_modules =
    crawlerai.acquire
    crawlerai.adapters
    crawlerai.api
    crawlerai.cli
    crawlerai.collect
    crawlerai.config_ir
    crawlerai.content
    crawlerai.core
    crawlerai.crawl
    crawlerai.db
    crawlerai.llm
    crawlerai.mcp_server
    crawlerai.recurring
    crawlerai.resolve
    crawlerai.scheduler
    crawlerai.schemas
    crawlerai.search
    crawlerai.services
    crawlerai.storage
    crawlerai.worker
forbidden_modules =
    babel
    price_parser
    dateparser
allow_indirect_imports = True

[importlinter:contract:adapters-isolated]
name = Nothing outside adapters imports adapters except acquire and collect
type = forbidden
source_modules =
    crawlerai.api
    crawlerai.cli
    crawlerai.config_ir
    crawlerai.content
    crawlerai.core
    crawlerai.crawl
    crawlerai.db
    crawlerai.llm
    crawlerai.mcp_server
    crawlerai.normalize
    crawlerai.recurring
    crawlerai.resolve
    crawlerai.scheduler
    crawlerai.schemas
    crawlerai.search
    crawlerai.services
    crawlerai.storage
    crawlerai.worker
forbidden_modules =
    crawlerai.adapters
allow_indirect_imports = True

# `|` siblings are independent of each other. acquire and adapters are `:` siblings because the adapters-isolated
# contract lets acquire import adapters. normalize sits above schemas because each normalizer reads the field's
# `FieldSpec`. collect sits above content because every collector reads the `ParsedPage`.
# services sits under the API and the MCP server, which both call it; the API sits over the MCP server,
# which it mounts at `/mcp`.
[importlinter:contract:layers]
name = Layering
type = layers
layers =
    crawlerai.api
    crawlerai.mcp_server
    crawlerai.services
    crawlerai.crawl | crawlerai.recurring | crawlerai.search
    crawlerai.config_ir
    crawlerai.resolve | crawlerai.llm
    crawlerai.collect
    crawlerai.content
    crawlerai.normalize
    crawlerai.schemas
    crawlerai.acquire : crawlerai.adapters
    crawlerai.db | crawlerai.storage
    crawlerai.core

# Config learning: the release executor shares no code with the engine beyond the IR model, so that the two
# executors agreeing is evidence that an export reproduces the engine. Its imports from crawlerai are the model and the
# one decode of state documents both executors read (serializer formats, the RSC Flight reader); their own imports are
# indirect, so they are allowed.
[importlinter:contract:release-executor-isolated]
name = The release executor imports only the IR model and the state decoders from crawlerai
type = forbidden
source_modules =
    crawlerai.config_ir.release_executor
forbidden_modules =
    crawlerai.**
ignore_imports =
    crawlerai.config_ir.release_executor -> crawlerai.config_ir.model
    crawlerai.config_ir.release_executor -> crawlerai.content.page
    crawlerai.config_ir.release_executor -> crawlerai.content.rsc
    crawlerai.config_ir.release_executor -> crawlerai.content.state
    crawlerai.config_ir.release_executor -> crawlerai.content.state_decoders
allow_indirect_imports = True

# Nor does the engine executor reach the release executor, directly or not.
[importlinter:contract:executors-independent]
name = The engine and release executors are independent
type = independence
modules =
    crawlerai.config_ir.executor
    crawlerai.config_ir.release_executor
