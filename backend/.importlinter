# Import contracts (ARCHITECTURE C8, SPEC-00 §5, INV-08). Run with `uv run lint-imports` from backend/.

[importlinter]
root_package = crawlerai
include_external_packages = True

# The eight field-type normalizers (SPEC-04 §4.1). A new type module is added here and to normalize-internals in
# the PR that creates it.
[importlinter:contract:normalize-independence]
name = One module per field type
type = independence
modules =
    crawlerai.normalize.text
    crawlerai.normalize.money
    crawlerai.normalize.enum
    crawlerai.normalize.url
    crawlerai.normalize.identifier
    crawlerai.normalize.date
    crawlerai.normalize.location
    crawlerai.normalize.range

# The dispatcher imports the type modules; the type modules import only `vocab` (vocabularies, their matcher) and
# `base` (results, context) from normalize.
# Independence between the type modules is the contract above, so they are `:` siblings here.
[importlinter:contract:normalize-internals]
name = Normalizer internals
type = layers
layers =
    crawlerai.normalize.dispatch
    crawlerai.normalize.text : crawlerai.normalize.money : crawlerai.normalize.enum : crawlerai.normalize.url : crawlerai.normalize.identifier : crawlerai.normalize.date : crawlerai.normalize.location : crawlerai.normalize.range
    crawlerai.normalize.vocab
    crawlerai.normalize.base

# Indirect imports are allowed: callers use the normalizers, which use these libraries.
[importlinter:contract:normalize-libs]
name = Only normalizers import normalization libraries
type = forbidden
source_modules =
    crawlerai.acquire
    crawlerai.adapters
    crawlerai.api
    crawlerai.cli
    crawlerai.collect
    crawlerai.config_ir
    crawlerai.content
    crawlerai.core
    crawlerai.crawl
    crawlerai.db
    crawlerai.eval
    crawlerai.llm
    crawlerai.mcp_server
    crawlerai.recurring
    crawlerai.resolve
    crawlerai.scheduler
    crawlerai.schemas
    crawlerai.services
    crawlerai.storage
    crawlerai.worker
forbidden_modules =
    babel
    price_parser
    dateparser
allow_indirect_imports = True

[importlinter:contract:adapters-isolated]
name = Nothing outside adapters imports adapters except acquire and collect
type = forbidden
source_modules =
    crawlerai.api
    crawlerai.cli
    crawlerai.config_ir
    crawlerai.content
    crawlerai.core
    crawlerai.crawl
    crawlerai.db
    crawlerai.eval
    crawlerai.llm
    crawlerai.mcp_server
    crawlerai.normalize
    crawlerai.recurring
    crawlerai.resolve
    crawlerai.scheduler
    crawlerai.schemas
    crawlerai.services
    crawlerai.storage
    crawlerai.worker
forbidden_modules =
    crawlerai.adapters
allow_indirect_imports = True

# `|` siblings are independent of each other. acquire and adapters are `:` siblings because the adapters-isolated
# contract lets acquire import adapters. normalize sits above schemas because each normalizer reads the field's
# `FieldSpec` (SPEC-04 §4.3). collect sits above content because every collector reads the `ParsedPage` (INV-26).
# services sits under the API and the MCP server, which both call it (SPEC-07 §4.7).
[importlinter:contract:layers]
name = Layering
type = layers
layers =
    crawlerai.api | crawlerai.mcp_server
    crawlerai.services
    crawlerai.crawl | crawlerai.recurring | crawlerai.eval
    crawlerai.config_ir
    crawlerai.resolve | crawlerai.llm
    crawlerai.collect
    crawlerai.content
    crawlerai.normalize
    crawlerai.schemas
    crawlerai.acquire : crawlerai.adapters
    crawlerai.db | crawlerai.storage
    crawlerai.core
