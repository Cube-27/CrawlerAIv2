# Import contracts. Run with `uv run lint-imports` from backend/.

[importlinter]
root_package = snowcrawl
include_external_packages = True

# The nine field-type normalizers. A new type module is added here and to normalize-internals in
# the PR that creates it.
[importlinter:contract:normalize-independence]
name = One module per field type
type = independence
modules =
    snowcrawl.normalize.text
    snowcrawl.normalize.money
    snowcrawl.normalize.enum
    snowcrawl.normalize.url
    snowcrawl.normalize.identifier
    snowcrawl.normalize.date
    snowcrawl.normalize.location
    snowcrawl.normalize.range
    snowcrawl.normalize.count
    snowcrawl.normalize.number

# The dispatcher imports the type modules; the type modules import only `vocab` (vocabularies, their matcher),
# `numbers` (CLDR number reading), `units` (CLDR unit patterns), `strings` (the shared text forms) and `base` (results,
# context) from normalize.
# Independence between the type modules is the contract above, so they are `:` siblings here.
[importlinter:contract:normalize-internals]
name = Normalizer internals
type = layers
layers =
    snowcrawl.normalize.dispatch
    snowcrawl.normalize.text : snowcrawl.normalize.money : snowcrawl.normalize.enum : snowcrawl.normalize.url : snowcrawl.normalize.identifier : snowcrawl.normalize.date : snowcrawl.normalize.location : snowcrawl.normalize.range : snowcrawl.normalize.count : snowcrawl.normalize.number
    snowcrawl.normalize.vocab : snowcrawl.normalize.numbers : snowcrawl.normalize.units
    snowcrawl.normalize.strings
    snowcrawl.normalize.base

# Indirect imports are allowed: callers use the normalizers, which use these libraries.
[importlinter:contract:normalize-libs]
name = Only normalizers import normalization libraries
type = forbidden
source_modules =
    snowcrawl.acquire
    snowcrawl.adapters
    snowcrawl.api
    snowcrawl.cli
    snowcrawl.collect
    snowcrawl.config_ir
    snowcrawl.content
    snowcrawl.core
    snowcrawl.crawl
    snowcrawl.db
    snowcrawl.llm
    snowcrawl.mcp_server
    snowcrawl.recurring
    snowcrawl.resolve
    snowcrawl.scheduler
    snowcrawl.schemas
    snowcrawl.search
    snowcrawl.services
    snowcrawl.storage
    snowcrawl.worker
forbidden_modules =
    babel
    price_parser
    dateparser
allow_indirect_imports = True

[importlinter:contract:adapters-isolated]
name = Nothing outside adapters imports adapters except acquire and collect
type = forbidden
source_modules =
    snowcrawl.api
    snowcrawl.cli
    snowcrawl.config_ir
    snowcrawl.content
    snowcrawl.core
    snowcrawl.crawl
    snowcrawl.db
    snowcrawl.llm
    snowcrawl.mcp_server
    snowcrawl.normalize
    snowcrawl.recurring
    snowcrawl.resolve
    snowcrawl.scheduler
    snowcrawl.schemas
    snowcrawl.search
    snowcrawl.services
    snowcrawl.storage
    snowcrawl.worker
forbidden_modules =
    snowcrawl.adapters
allow_indirect_imports = True

# `|` siblings are independent of each other. acquire and adapters are `:` siblings because the adapters-isolated
# contract lets acquire import adapters. normalize sits above schemas because each normalizer reads the field's
# `FieldSpec`. collect sits above content because every collector reads the `ParsedPage`.
# Services sits under the API and the MCP server, which both call it; the API sits over the MCP server,
# which it mounts at `/mcp`.
[importlinter:contract:layers]
name = Layering
type = layers
layers =
    snowcrawl.api
    snowcrawl.mcp_server
    snowcrawl.services
    snowcrawl.crawl | snowcrawl.recurring | snowcrawl.search
    snowcrawl.config_ir
    snowcrawl.resolve | snowcrawl.llm
    snowcrawl.collect
    snowcrawl.content
    snowcrawl.normalize
    snowcrawl.schemas
    snowcrawl.acquire : snowcrawl.adapters
    snowcrawl.db | snowcrawl.storage
    snowcrawl.core

# Config learning: the release executor shares no code with the engine beyond the IR model, so that the two
# executors agreeing is evidence that an export reproduces the engine. Its imports from snowcrawl are the model and the
# one decode of state documents both executors read (serializer formats, the RSC Flight reader); their own imports are
# indirect, so they are allowed.
[importlinter:contract:release-executor-isolated]
name = The release executor imports only the IR model and the state decoders from snowcrawl
type = forbidden
source_modules =
    snowcrawl.config_ir.release_executor
forbidden_modules =
    snowcrawl.**
ignore_imports =
    snowcrawl.config_ir.release_executor -> snowcrawl.config_ir.model
    snowcrawl.config_ir.release_executor -> snowcrawl.content.page
    snowcrawl.config_ir.release_executor -> snowcrawl.content.rsc
    snowcrawl.config_ir.release_executor -> snowcrawl.content.state
    snowcrawl.config_ir.release_executor -> snowcrawl.content.state_decoders
allow_indirect_imports = True

# Nor does the engine executor reach the release executor, directly or not.
[importlinter:contract:executors-independent]
name = The engine and release executors are independent
type = independence
modules =
    snowcrawl.config_ir.executor
    snowcrawl.config_ir.release_executor
