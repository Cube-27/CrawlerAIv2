/data/
/captures/
/eval-private/
/var/
# Local filesystem object store used by `make dev` (SPEC-00 §4.4).
.data/
*.zst
eval-aggregate.json
hidden_hosts*.txt
sites*.txt

# --- Python ---
# Written by the build: the git SHA in ENGINE_VERSION (SPEC-01 §4.7).
backend/VERSION
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node / frontend ---
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo
.pnpm-store/
npm-debug.log*
pnpm-debug.log*

# --- Browsers / test artifacts ---
playwright-report/
test-results/
.cache/ms-playwright/

# --- SBOM and generated reports ---
sbom*.json
reports/

